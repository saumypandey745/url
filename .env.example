# PORT CONFIGURATION
PORT=4000
WORKER_PORT=4001
CLIENT_PORT=3000

# DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secplatform?schema=public"
# DEV FALLBACK (SQLite)
SQLITE_URL="file:./dev.db"

# REDIS & QUEUE
REDIS_URL="redis://localhost:6379"

# SECURITY & AUTHENTICATION
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
SESSION_SECRET="super-secret-session-key-change-in-production"

# SCANNER SAFETY & LIMITS
SCAN_TIMEOUT=10000
SCAN_RATE_LIMIT=10
SCAN_CONCURRENCY=5
MAX_RESPONSE_SIZE=5242880
ALLOWED_SCAN_SCHEMES="http,https"

# SSRF PROTECTION
BLOCK_PRIVATE_NETWORKS=true
ALLOW_INTERNAL_OVERRIDE=false

# AI ANALYST PROVIDER
AI_PROVIDER="rule_based" # Options: rule_based, openai, gemini
OPENAI_API_KEY=""
GEMINI_API_KEY=""
